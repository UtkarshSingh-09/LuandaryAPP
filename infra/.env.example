# Application Environment
APP_ENV=dev
DOMAIN=localhost
ACME_EMAIL=admin@campuslaundry.example
IMAGE_TAG=latest

# Database configuration
POSTGRES_DB=campuslaundry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/campuslaundry
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE=768MB

# Redis configuration
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# Uvicorn configuration
UVICORN_WORKERS=2
LOG_LEVEL=INFO

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_at_least_48_bytes_long_random_dev_only_key_123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Pepper secrets for HMAC hashing (Must remain static)
OTP_PEPPER=dev_otp_pepper_secret_key_at_least_32_bytes_long
CODE_PEPPER=dev_code_pepper_secret_key_at_least_32_bytes
CODE_ENC_KEY=7VzZ9H8k_a3xR1_sQ6vT2nK5lM8pY0wX4uC9bE2rF1A=

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@campuslaundry.example
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword123!
TOTP_ISSUER=CampusLaundry

# Mail / SMTP (Mailpit for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@campuslaundry.example

# S3 Object Storage (Minio for dev or AWS S3 Mumbai)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_MEDIA=cl-dev-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_SIGNED_URL_TTL_SECONDS=600

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-k7B2mF0o8G1h9J2k3L4m5N6o7P8q9R0s1T2u3V4w5X6y7Z8a9B0c1D2e3F4=
VAPID_PRIVATE_KEY=dev_vapid_private_key_32_bytes_secret
VAPID_SUBJECT=mailto:admin@campuslaundry.example

# Payment provider (mock, phonepe, paytm)
PAYMENT_PROVIDER=mock
WEBHOOK_BASE_URL=http://localhost:8000/api/v1/webhooks
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# Sentry
SENTRY_DSN_API=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.05
METRICS_TOKEN=internal_metrics_token_dev
